<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Ranger</AssemblyName>
    <RootNamespace>Ranger</RootNamespace>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Version>$(AssemblyVersion)</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Configurations>Debug;Release</Configurations>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!--
      Same layout convention as Framesaver: this project lives in F:\SPT\Mods\Ranger
      rather than under an SPT install's Development\ folder, so SptDir is spelled
      out. Change this one line if the install moves.
    -->
    <SptDir>F:\SPT\SPT-4.1</SptDir>
    <ManagedDir>$(SptDir)\EscapeFromTarkov_Data\Managed</ManagedDir>
    <BepInExDir>$(SptDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="spt-reflection">
      <HintPath>$(BepInExDir)\plugins\spt\spt-reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="spt-common">
      <HintPath>$(BepInExDir)\plugins\spt\spt-common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(ManagedDir)\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AnimationSystem.Types">
      <HintPath>$(ManagedDir)\AnimationSystem.Types.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(ManagedDir)\UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    RefuseDirtyDeploy, ported from Framesaver 2026-08-19 now that the extraction has
    landed real code and a first tagged build (the capstone cutover, b8a2a19/96e3871,
    raid-verified) exists to protect. Same reasoning as Framesaver's own copy of this
    target - see its comments there for the full argument - reproduced here rather
    than shared, because MSBuild targets do not import across independent projects
    without their own machinery, and this mod needs to be maintainable on its own
    without a live reference to Framesaver's tree.

    Scope differs from Framesaver's by file layout only: Ranger's own top-level .cs
    files (Plugin.cs, Telemetry.cs, TelemetryBus.cs, ProtocolRunner.cs,
    PlayerLoopProfiler.cs, GpuTelemetry.cs) plus Patches/*.cs plus Ranger.csproj
    itself - the equivalent of Framesaver's "*.cs Patches/*.cs Framesaver.csproj"
    pathspec, just naming this repo's own root instead.
  -->
  <Target Name="RefuseDirtyDeploy" BeforeTargets="PostBuild" Condition="'$(Deploy)' == 'true'"
          DependsOnTargets="InitializeSourceControlInformation">
    <Exec Command="git status --porcelain -- *.cs Patches/*.cs Ranger.csproj"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" StandardOutputImportance="low"
          ContinueOnError="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="RangerDirty" />
      <Output TaskParameter="ExitCode" PropertyName="RangerGitExit" />
    </Exec>

    <Error Condition="'$(RangerGitExit)' != '0' And '$(AllowUnverifiedDeploy)' != 'true'"
           Text="Ranger: refusing to deploy. git could not run, so the clean-tree check was SKIPPED, not passed - and SourceLink reads .git directly, so this binary still carries a plausible-looking stamp that nothing has checked against its source. Re-run with -p:AllowUnverifiedDeploy=true if you accept that." />

    <Warning Condition="'$(AllowUnverifiedDeploy)' == 'true' And '$(RangerGitExit)' != '0'"
             Text="Ranger: AllowUnverifiedDeploy is set and git could not run, so the clean-tree check did not run. This binary's stamp may not describe its source." />

    <Error Condition="'$(SourceRevisionId)' == '' And '$(AllowUnverifiedDeploy)' != 'true'"
           Text="Ranger: refusing to deploy. This assembly carries NO commit stamp, so every telemetry log it writes will read commit:&quot;&quot; and can never be tied back to a build. Build from a git checkout, or re-run with -p:AllowUnverifiedDeploy=true if you accept anonymous logs." />

    <Warning Condition="'$(AllowUnverifiedDeploy)' == 'true' And '$(SourceRevisionId)' == ''"
             Text="Ranger: AllowUnverifiedDeploy is set and there is no commit stamp. Logs from this binary will read commit:&quot;&quot; and cannot be attributed to a build." />

    <Error Condition="'$(RangerGitExit)' == '0' And '$(RangerDirty)' != ''"
           Text="Ranger: refusing to deploy. Compiled sources differ from HEAD, so the build stamp would name a commit this binary was not built from:%0A$(RangerDirty)%0ACommit first, then rebuild - the stamp is read from git HEAD at build time." />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Copy Condition="'$(Deploy)' == 'true'"
          SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\" />
    <Message Condition="'$(Deploy)' == 'true'" Importance="high"
             Text="Ranger: DEPLOYED $(InformationalVersion) to $(BepInExDir)\plugins\" />
    <Message Condition="'$(Deploy)' != 'true'" Importance="high"
             Text="Ranger: built $(InformationalVersion), NOT deployed. -p:Deploy=true copies into $(BepInExDir)\plugins\" />
  </Target>

</Project>
